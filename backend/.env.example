PROJECT_NAME="Bayora Isolation Lab"
VERSION="1.0.0"
API_V1_STR="/api"
DATABASE_URL="sqlite:///./bayora.db"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
MAX_UPLOAD_SIZE_BYTES=10485760
UPLOAD_DIR="./uploads"

# Cryptographic Security & JWT Configuration
SECRET_KEY="your-cryptographic-secret-key-min-32-characters-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Bootstrap Passwords (Used only when running `py -m app.cli.bootstrap`)
BAYORA_ADMIN_PASSWORD="YourSecureAdminPasswordHere!"
BAYORA_ANALYST_PASSWORD="YourSecureAnalystPasswordHere!"
BAYORA_VIEWER_PASSWORD="YourSecureViewerPasswordHere!"

# Optional AI Advisory Enhancer (Groq Fast LLM integration)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"
